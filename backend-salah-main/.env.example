APP_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=5000

# Genere al menos 32 caracteres aleatorios. Nunca reutilice este ejemplo.
AUTH_TOKEN_SECRET=
COOKIE_SECURE=false
TRUSTED_PROXY_CIDRS=

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=disable

# En produccion, activelo solo durante una migracion controlada.
RUN_MIGRATIONS=true
INITIAL_ADMIN_USER=
INITIAL_ADMIN_PASSWORD=
